{
  "name": "codememory",
  "version": "0.7.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3721",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "core:build": "npm --workspace @codememory/core run build",
    "sync-agent:build": "npm --workspace codememory-sync run build",
    "desktop:dev": "DATA_SOURCE_MODE=local-desktop NEXT_PUBLIC_APP_MODE=desktop NEXT_PUBLIC_DATA_SOURCE_MODE=local-desktop tauri dev",
    "desktop:build": "NEXT_PUBLIC_APP_MODE=desktop next build && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.0.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.15",
    "next-auth": "^4.24.10",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "14.2.15",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
